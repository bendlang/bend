# a 6000-character string literal checks: the checker holds a literal as
# one Lit node, not as a constructor per character (which overflowed its
# stack near 5000 characters). main is a function, so the test is checked
# and interpreted; the interpreter unfolds the literal to count it.
import Base

def text() -> String:
  ""

def main(n: Nat) -> Nat:
  Nat.add(n, String.length(text()))

#|n => Nat.add(n, 6000n)
