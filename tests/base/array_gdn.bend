# Array.gdn: two value heads of 64 rows over key heads of 32 (c = 256,
# din = 128); o (128 values, then the 2 group sums), 64 state values (rounded
# to bfloat16: Metal's sums move their last bits) and 64 window values as F32
# bits. a and dt are halved, the state quartered.
import Base

def bits(+v: F32) -> U32:
  match v:
    case F32{+w}:
      U32{w}

def f32(+u: U32) -> F32:
  match u:
    case U32{+w}:
      F32{w}

def pat(+i: U32, +s: U32) -> F32:
  +h = (i * 2654435761 + s : U32)
  f32(((1040187392 + h % 25165824) .|. (((h >> 7n) .&. 1) << 31n) : U32))

def fill(n: Nat, a: Array<F32>, +i: U32, +s: U32, +k: F32) -> Array<F32>:
  match n:
    case 0n:
      a
    case 1n+p:
      fill(p, Array.set(F32, a, i, (pat(i, s) * k : F32)), (i + 1 : U32), s, k)

def ubits(a: Array<F32>) -> Array<U32>:
  Array.map(~F32, ~U32, ~(v => bits(v)), a)

def take.k(r: Array<U32> & U32, acc: List<U32>) -> Array<U32> & List<U32>:
  (a, +x) = r
  (a, x <> acc)

# n slots of a ending at j, in order, onto acc.
def take(n: Nat, r: Array<U32> & List<U32>, +j: U32) -> Array<U32> & List<U32>:
  match n:
    case 0n:
      r
    case 1n+p:
      (a, acc) = r
      take(p, take.k(Array.get(U32, a, j), acc), (j - 1 : U32))

def show(r: Array<U32> & List<U32>) -> String:
  (a, xs) = r
  _ = a
  List.show(~&1, ~U32, ~(v => U32.show(v)), xs)

def fbits(+n: Nat, a: Array<F32>, +i: U32) -> String:
  show(take(n, (ubits(a), Nil{}), (i + U32.from_nat(n) - 1 : U32)))

def ubits.show(+n: Nat, a: Array<U32>, +i: U32) -> String:
  show(take(n, (a, Nil{}), (i + U32.from_nat(n) - 1 : U32)))

def done(o: Array<F32>, y: Array<F32>, w: Array<F32>, s: Array<F32>, cw: Array<U32>, ab: Array<U32>, sn: Array<U32>) -> IO(Unit):
  _ = y
  _ = cw
  _ = ab
  _ = sn
  do IO<Unit>:
    IO.print(fbits(130n, o, 0))
    IO.print(fbits(64n, Array.map(~F32, ~F32, ~(v => Array.q4mv.round(v)), s), 1000))
    IO.print(fbits(64n, w, 200))

def out(q: (((((Array<F32> & Array<F32>) & Array<F32>) & Array<U32>) & Array<U32>) & Array<U32>) & Array<F32>) -> IO(Unit):
  ((((((y, w), s), cw), ab), sn), o) = q
  done(Array.q4wait(o), y, w, s, cw, ab, sn)

def main() -> IO(Unit):
  out(Array.gdn(fill(388n, Array.new(F32, 9n, 0.0), 0, 5, 1.0), fill(768n, Array.new(F32, 10n, 0.0), 0, 7, 1.0),
    fill(4096n, Array.new(F32, 12n, 0.0), 0, 9, 0.25), ubits(fill(1024n, Array.new(F32, 10n, 0.0), 0, 11, 0.5)),
    ubits(fill(4n, Array.new(F32, 2n, 0.0), 0, 13, 0.5)), ubits(fill(64n, Array.new(F32, 6n, 0.0), 0, 17, 1.0)),
    Array.new(F32, 8n, 0.0), 256, 32, 64, 2, 128, 64, 0.000001))
