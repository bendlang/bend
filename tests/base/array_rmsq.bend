# Array.rmsq: 128 values (two groups) with the residual add, then without;
# o (128 values, the 2 group sums, then untouched zeros) and x as F32 bits. Inputs are F32
# bit patterns in +-[0.125, 2), the weights as F32 bits; eps is the F32 nearest 1e-6.
import Base

def bits(+v: F32) -> U32:
  match v:
    case F32{+w}:
      U32{w}

def f32(+u: U32) -> F32:
  match u:
    case U32{+w}:
      F32{w}

def pat(+i: U32, +s: U32) -> F32:
  +h = (i * 2654435761 + s : U32)
  f32(((1040187392 + h % 25165824) .|. (((h >> 7n) .&. 1) << 31n) : U32))

def fill(n: Nat, a: Array<F32>, +i: U32, +s: U32) -> Array<F32>:
  match n:
    case 0n:
      a
    case 1n+p:
      fill(p, Array.set(F32, a, i, pat(i, s)), (i + 1 : U32), s)

def show(a: Array<F32>) -> String:
  List.show(~&1, ~U32, ~(v => U32.show(v)), Array.to_list(~U32, Array.map(~F32, ~U32, ~(v => bits(v)), a)))

# y and w stay live until the wait: the GPU reads them until then.
def fin(o: Array<F32>, x: Array<F32>, y: Array<F32>, w: Array<U32>) -> Array<F32> & Array<F32>:
  _ = y
  _ = w
  (o, x)

def put(r: Array<F32> & Array<F32>) -> IO(Unit):
  (o, x) = r
  do IO<Unit>:
    IO.print(show(o))
    IO.print(show(x))

def out(q: ((Array<F32> & Array<F32>) & Array<U32>) & Array<F32>) -> IO(Unit):
  (((x, y), w), o) = q
  put(fin(Array.q4wait(o), x, y, w))

def one(+add: U32) -> IO(Unit):
  out(Array.rmsq(fill(128n, Array.new(F32, 7n, 0.0), 0, 11), fill(128n, Array.new(F32, 7n, 0.0), 0, 23),
    Array.map(~F32, ~U32, ~(v => bits(v)), fill(128n, Array.new(F32, 7n, 0.0), 0, 37)), Array.new(F32, 8n, 0.0), 128, f32(897988541), add))

def main() -> IO(Unit):
  do IO<Unit>:
    one(1)
    one(0)
