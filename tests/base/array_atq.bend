# Array.atq: 4 query heads over 2 KV heads of 64, rotating 16 pairs, at
# position 5 over random caches; o (256 values, then the 4 group sums) and
# the caches' new row as F32 bits.
import Base

def bits(+v: F32) -> U32:
  match v:
    case F32{+w}:
      U32{w}

def f32(+u: U32) -> F32:
  match u:
    case U32{+w}:
      F32{w}

def pat(+i: U32, +s: U32) -> F32:
  +h = (i * 2654435761 + s : U32)
  f32(((1040187392 + h % 25165824) .|. (((h >> 7n) .&. 1) << 31n) : U32))

def fill(n: Nat, a: Array<F32>, +i: U32, +s: U32, +k: F32) -> Array<F32>:
  match n:
    case 0n:
      a
    case 1n+p:
      fill(p, Array.set(F32, a, i, (pat(i, s) * k : F32)), (i + 1 : U32), s, k)

def ubits(a: Array<F32>) -> Array<U32>:
  Array.map(~F32, ~U32, ~(v => bits(v)), a)

def take.k(r: Array<U32> & U32, acc: List<U32>) -> Array<U32> & List<U32>:
  (a, +x) = r
  (a, x <> acc)

# n slots of a ending at j, in order, onto acc.
def take(n: Nat, r: Array<U32> & List<U32>, +j: U32) -> Array<U32> & List<U32>:
  match n:
    case 0n:
      r
    case 1n+p:
      (a, acc) = r
      take(p, take.k(Array.get(U32, a, j), acc), (j - 1 : U32))

def show(r: Array<U32> & List<U32>) -> String:
  (a, xs) = r
  _ = a
  List.show(~&1, ~U32, ~(v => U32.show(v)), xs)

def fbits(+n: Nat, a: Array<F32>, +i: U32) -> String:
  show(take(n, (ubits(a), Nil{}), (i + U32.from_nat(n) - 1 : U32)))

def ubits.show(+n: Nat, a: Array<U32>, +i: U32) -> String:
  show(take(n, (a, Nil{}), (i + U32.from_nat(n) - 1 : U32)))

def done(o: Array<F32>, y: Array<F32>, kc: Array<U32>, vc: Array<U32>, kw: Array<U32>, cs: Array<F32>) -> IO(Unit):
  _ = y
  _ = kw
  _ = cs
  do IO<Unit>:
    IO.print(fbits(260n, o, 0))
    IO.print(ubits.show(128n, kc, 640))
    IO.print(ubits.show(128n, vc, 640))

def out(q: ((((Array<F32> & Array<U32>) & Array<U32>) & Array<U32>) & Array<F32>) & Array<F32>) -> IO(Unit):
  (((((y, kc), vc), kw), cs), o) = q
  done(Array.q4wait(o), y, kc, vc, kw, cs)

def main() -> IO(Unit):
  out(Array.atq(fill(768n, Array.new(F32, 10n, 0.0), 0, 5, 1.0), ubits(fill(1024n, Array.new(F32, 10n, 0.0), 0, 7, 1.0)),
    ubits(fill(1024n, Array.new(F32, 10n, 0.0), 0, 9, 1.0)), ubits(fill(128n, Array.new(F32, 7n, 0.0), 0, 11, 1.0)),
    fill(32n, Array.new(F32, 5n, 0.0), 0, 13, 0.5), Array.new(F32, 9n, 0.0), 5, 4, 2, 64, 16, 0.000001))
