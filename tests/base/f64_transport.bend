# an F64 keeps every bit through a record, a pair, a Maybe, a recursion, a
# fork, an Array get and swap, a closure, a generic pick and a ! call:
# moving an F64 never canonicalizes it, so signaling and payload NaNs, -0
# and subnormals come back as they went (only arithmetic makes the one NaN)
import Base

type BF is Data:
  BF{a: U32, b: F64, c: Bool}

def vals() -> List<U64>:
  [0u64, 1u64, 4294967296u64,
   281474976710656u64, 9007199254740991u64, 9007199254740992u64,
   9007199254740993u64, 9223372036854775808u64, 18446744073709551615u64,
   72057594037927937u64, 144115188075856163u64, 360287970189639680u64,
   9151595913498591232u64, 9223372036854775809u64, 18374686483966590975u64,
   9221120237041090851u64, 18443366373989023744u64, 1u64]

def f_id(x: F64) -> F64:
  x

def f_unbox(v: BF) -> F64:
  match v:
    case BF{a, b, c}:
      b

law f_rec:
  for n: Nat
  for x: F64
  F64

def f_rec(n, x):
  match n:
    case 0n:
      x
    case 1n+p:
      F64{U64.xor(F64.bits(f_rec(p, x)), 0u64)}

def f_fork(+x: F64) -> F64:
  a b = f_id(x) f_id(F64.neg(x))
  F64{U64.xor(F64.bits(a), U64.xor(F64.bits(F64.neg(b)), F64.bits(x)))}

def f_snd(r: Array<F64> & F64) -> F64:
  (a2, v) = r
  v

def f_mk(x: F64) -> F64 -> F64:
  y => F64{U64.xor(F64.bits(y), F64.bits(x))}

def f_path(k: Nat, x: F64) -> F64:
  match k:
    case 0n:
      f_id(x)
    case 1n:
      f_unbox(BF{7, x, True{}})
    case 2n:
      Pair.snd(U32, F64, (5, x))
    case 3n:
      Pair.fst(F64, U32, (x, 9))
    case 4n:
      Maybe.default(&2, F64, Some{x}, F64{0u64})
    case 5n:
      f_rec(40n, x)
    case 6n:
      f_fork(x)
    case 7n:
      f_snd(Array.get(F64, Array.set(F64, [F64{0u64} : F64*4n], 2, x), 2))
    case 8n:
      f_snd(Array.swap(F64, Array.set(F64, [F64{0u64} : F64*2n], 1, x), 1,
        F64{3u64}))
    case 9n:
      f_mk(x)(F64{0u64})
    case 10n:
      Bool.pick(F64, True{}, x, F64{0u64})
    case _:
      f_id!(x)

law each:
  for +k: Nat
  for xs: List<U64>
  String

def each(k, xs):
  match xs:
    case Nil{}:
      "|"
    case Con{h, t}:
      U64.show(F64.bits(f_path(k, F64{h}))) ++ " " ++ each(k, t)

law all:
  for +n: Nat
  String

def all(n):
  match n:
    case 0n:
      each(0n, vals())
    case 1n+p:
      all(p) ++ " " ++ each(1n+p, vals())

def main() -> IO(Unit):
  IO.print(all(11n))

