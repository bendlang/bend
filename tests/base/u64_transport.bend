# a U64 keeps every bit through a record, a pair, a Maybe, a recursion, a
# fork, an Array get and swap, a closure, a generic pick and a ! call:
# among the values are 2^63 (the reference bit) and 2^64-1 (the hole
# word), which a cell holding a raw 64-bit word would misread as tags
import Base

type BU is Data:
  BU{a: U32, b: U64, c: Bool}

def vals() -> List<U64>:
  [0u64, 1u64, 4294967296u64,
   281474976710656u64, 9007199254740991u64, 9007199254740992u64,
   9007199254740993u64, 9223372036854775808u64, 18446744073709551615u64,
   72057594037927937u64, 144115188075856163u64, 360287970189639680u64,
   9151595913498591232u64, 9223372036854775809u64, 18374686483966590975u64,
   9221120237041090851u64, 18443366373989023744u64, 1u64]

def u_id(x: U64) -> U64:
  x

def u_unbox(v: BU) -> U64:
  match v:
    case BU{a, b, c}:
      b

law u_rec:
  for n: Nat
  for x: U64
  U64

def u_rec(n, x):
  match n:
    case 0n:
      x
    case 1n+p:
      U64.xor(u_rec(p, x), 0u64)

def u_fork(+x: U64) -> U64:
  a b = u_id(x) u_id(U64.not(x))
  U64.xor(a, U64.xor(U64.not(b), x))

def u_snd(r: Array<U64> & U64) -> U64:
  (a2, v) = r
  v

def u_mk(x: U64) -> U64 -> U64:
  y => U64.xor(y, x)

def u_path(k: Nat, x: U64) -> U64:
  match k:
    case 0n:
      u_id(x)
    case 1n:
      u_unbox(BU{7, x, True{}})
    case 2n:
      Pair.snd(U32, U64, (5, x))
    case 3n:
      Pair.fst(U64, U32, (x, 9))
    case 4n:
      Maybe.default(&2, U64, Some{x}, 0u64)
    case 5n:
      u_rec(40n, x)
    case 6n:
      u_fork(x)
    case 7n:
      u_snd(Array.get(U64, Array.set(U64, [0u64 : U64*4n], 2, x), 2))
    case 8n:
      u_snd(Array.swap(U64, Array.set(U64, [0u64 : U64*2n], 1, x), 1, 3u64))
    case 9n:
      u_mk(x)(0u64)
    case 10n:
      Bool.pick(U64, True{}, x, 0u64)
    case _:
      u_id!(x)

law each:
  for +k: Nat
  for xs: List<U64>
  String

def each(k, xs):
  match xs:
    case Nil{}:
      "|"
    case Con{h, t}:
      U64.show(u_path(k, h)) ++ " " ++ each(k, t)

law all:
  for +n: Nat
  String

def all(n):
  match n:
    case 0n:
      each(0n, vals())
    case 1n+p:
      all(p) ++ " " ++ each(1n+p, vals())

def main() -> IO(Unit):
  IO.print(all(11n))

