# a chain of destructures, each of the field the one before bound: each
# defers its substitutions (a ctr, then the field's own var column) and the
# next statement resolves its scrutinee through them, never the whole rest
type L is Data:
  C{next: L}

law main:
  for x0: L
  L

def main(x0):
  C{x1} = x0
  C{x2} = x1
  C{x3} = x2
  C{x4} = x3
  C{x5} = x4
  C{x6} = x5
  C{x7} = x6
  C{x8} = x7
  C{x9} = x8
  C{x10} = x9
  C{x11} = x10
  C{x12} = x11
  C{x13} = x12
  C{x14} = x13
  C{x15} = x14
  C{x16} = x15
  C{x17} = x16
  C{x18} = x17
  C{x19} = x18
  C{x20} = x19
  C{x21} = x20
  C{x22} = x21
  C{x23} = x22
  C{x24} = x23
  C{x25} = x24
  C{x26} = x25
  C{x27} = x26
  C{x28} = x27
  C{x29} = x28
  C{x30} = x29
  C{x31} = x30
  C{x32} = x31
  C{x33} = x32
  C{x34} = x33
  C{x35} = x34
  C{x36} = x35
  C{x37} = x36
  C{x38} = x37
  C{x39} = x38
  C{x40} = x39
  C{x41} = x40
  C{x42} = x41
  C{x43} = x42
  C{x44} = x43
  C{x45} = x44
  C{x46} = x45
  C{x47} = x46
  C{x48} = x47
  x48
