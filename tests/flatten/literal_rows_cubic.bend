def main() -> IO(Unit):
  do IO<Unit>:
    Unit <- IO.print(U32.show(pick(0n)))
    Unit <- IO.print(U32.show(pick(7n)))
    Unit <- IO.print(U32.show(pick(499n)))
    Unit <- IO.print(U32.show(pick(500n)))
    IO.print(U32.show(pick(1000n)))

