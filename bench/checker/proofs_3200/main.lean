namespace Bench

inductive Nat : Type where
  | Z : Nat
  | S : Nat → Nat

def add : Nat → Nat → Nat
  | .Z, b => b
  | .S a, b => .S (add a b)

theorem add_zero (a : Nat) : add a .Z = a := by
  induction a with
  | Z => rfl
  | S a ih => simp only [add, ih]

theorem add_succ (a b : Nat) : add a (.S b) = .S (add a b) := by
  induction a with
  | Z => rfl
  | S a ih => simp only [add, ih]

theorem add_comm (a b : Nat) : add a b = add b a := by
  induction a with
  | Z => simp only [add, add_zero]
  | S a ih => simp only [add, add_succ, ih]

inductive An0 : Type where
  | Az : An0
  | As : An0 → An0

def aadd0 : An0 → An0 → An0
  | .Az, b => b
  | .As a, b => .As (aadd0 a b)

theorem aadd0_zero (a : An0) : aadd0 a .Az = a := by
  induction a with
  | Az => rfl
  | As a ih => simp only [aadd0, ih]

theorem aadd0_succ (a b : An0) : aadd0 a (.As b) = .As (aadd0 a b) := by
  induction a with
  | Az => rfl
  | As a ih => simp only [aadd0, ih]

theorem aadd0_comm (a b : An0) : aadd0 a b = aadd0 b a := by
  induction a with
  | Az => simp only [aadd0, aadd0_zero]
  | As a ih => simp only [aadd0, aadd0_succ, ih]

inductive Bl1 : Type where
  | Bn : Bl1
  | Bc : Nat → Bl1 → Bl1

def bcat1 : Bl1 → Bl1 → Bl1
  | .Bn, ys => ys
  | .Bc h t, ys => .Bc h (bcat1 t ys)

def blen1 : Bl1 → Nat
  | .Bn => .Z
  | .Bc _ t => .S (blen1 t)

theorem bcat1_nil (xs : Bl1) : bcat1 xs .Bn = xs := by
  induction xs with
  | Bn => rfl
  | Bc h t ih => simp only [bcat1, ih]

theorem bcat1_assoc (xs ys zs : Bl1) : bcat1 (bcat1 xs ys) zs = bcat1 xs (bcat1 ys zs) := by
  induction xs with
  | Bn => rfl
  | Bc h t ih => simp only [bcat1, ih]

theorem blen1_cat (xs ys : Bl1) : blen1 (bcat1 xs ys) = add (blen1 xs) (blen1 ys) := by
  induction xs with
  | Bn => rfl
  | Bc h t ih => simp only [bcat1, blen1, add, ih]

inductive Ct2 : Type where
  | Cl : Nat → Ct2
  | Cn : Ct2 → Ct2 → Ct2

def cmir2 : Ct2 → Ct2
  | .Cl v => .Cl v
  | .Cn l r => .Cn (cmir2 r) (cmir2 l)

def csize2 : Ct2 → Nat
  | .Cl _ => .S .Z
  | .Cn l r => add (csize2 l) (csize2 r)

theorem cmir2_mir (t : Ct2) : cmir2 (cmir2 t) = t := by
  induction t with
  | Cl v => rfl
  | Cn l r ihl ihr => simp only [cmir2, ihl, ihr]

theorem csize2_mir (t : Ct2) : csize2 (cmir2 t) = csize2 t := by
  induction t with
  | Cl v => rfl
  | Cn l r ihl ihr => simp only [cmir2, csize2, ihl, ihr]; rw [add_comm]

