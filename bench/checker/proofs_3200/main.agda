blen1 : Bl1 -> Nat
blen1 Bn1 = Z
blen1 (Bc1 h t) = S (blen1 t)

bcat1-nil : (xs : Bl1) -> Eq (bcat1 xs Bn1) xs
bcat1-nil Bn1 = refl
