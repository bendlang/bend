module main where

data Eq {A : Set} (x : A) : A -> Set where
  refl : Eq x x
{-# BUILTIN EQUALITY Eq #-}

data Nat : Set where
  Z : Nat
  S : Nat -> Nat

add : Nat -> Nat -> Nat
add Z b = b
add (S a) b = S (add a b)

add-zero : (a : Nat) -> Eq (add a Z) a
add-zero Z = refl
add-zero (S a) rewrite add-zero a = refl

add-succ : (a b : Nat) -> Eq (add a (S b)) (S (add a b))
add-succ Z b = refl
add-succ (S a) b rewrite add-succ a b = refl

add-comm : (a b : Nat) -> Eq (add a b) (add b a)
add-comm Z b rewrite add-zero b = refl
add-comm (S a) b rewrite add-succ b a | add-comm a b = refl

data An0 : Set where
  Az0 : An0
  As0 : An0 -> An0

aadd0 : An0 -> An0 -> An0
aadd0 Az0 b = b
aadd0 (As0 a) b = As0 (aadd0 a b)

aadd0-zero : (a : An0) -> Eq (aadd0 a Az0) a
aadd0-zero Az0 = refl
aadd0-zero (As0 a) rewrite aadd0-zero a = refl

aadd0-succ : (a b : An0) -> Eq (aadd0 a (As0 b)) (As0 (aadd0 a b))
aadd0-succ Az0 b = refl
aadd0-succ (As0 a) b rewrite aadd0-succ a b = refl

aadd0-comm : (a b : An0) -> Eq (aadd0 a b) (aadd0 b a)
aadd0-comm Az0 b rewrite aadd0-zero b = refl
aadd0-comm (As0 a) b rewrite aadd0-succ b a | aadd0-comm a b = refl

