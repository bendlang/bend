bcat1-assoc : (xs ys zs : Bl1) -> Eq (bcat1 (bcat1 xs ys) zs) (bcat1 xs (bcat1 ys zs))
bcat1-assoc Bn1 ys zs = refl
bcat1-assoc (Bc1 h t) ys zs rewrite bcat1-assoc t ys zs = refl

blen1-cat : (xs ys : Bl1) -> Eq (blen1 (bcat1 xs ys)) (add (blen1 xs) (blen1 ys))
