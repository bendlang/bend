theory main
  imports Main
begin

datatype Nat = Z | S Nat

fun add :: "Nat => Nat => Nat" where
  "add Z b = b"
| "add (S a) b = S (add a b)"

lemma add_zero: "add a Z = a"
  by (induct a) simp_all

lemma add_succ: "add a (S b) = S (add a b)"
  by (induct a) simp_all

lemma add_comm: "add a b = add b a"
  by (induct a) (simp_all add: add_zero add_succ)

datatype An0 = Az0 | As0 An0

fun aadd0 :: "An0 => An0 => An0" where
  "aadd0 Az0 b = b"
| "aadd0 (As0 a) b = As0 (aadd0 a b)"

lemma aadd0_zero: "aadd0 a Az0 = a"
  by (induct a) simp_all

lemma aadd0_succ: "aadd0 a (As0 b) = As0 (aadd0 a b)"
  by (induct a) simp_all

lemma aadd0_comm: "aadd0 a b = aadd0 b a"
  by (induct a) (simp_all add: aadd0_zero aadd0_succ)

datatype Bl1 = Bn1 | Bc1 Nat Bl1

fun bcat1 :: "Bl1 => Bl1 => Bl1" where
  "bcat1 Bn1 ys = ys"
| "bcat1 (Bc1 h t) ys = Bc1 h (bcat1 t ys)"

fun blen1 :: "Bl1 => Nat" where
  "blen1 Bn1 = Z"
| "blen1 (Bc1 h t) = S (blen1 t)"

lemma bcat1_nil: "bcat1 xs Bn1 = xs"
  by (induct xs) simp_all

lemma bcat1_assoc: "bcat1 (bcat1 xs ys) zs = bcat1 xs (bcat1 ys zs)"
  by (induct xs) simp_all

lemma blen1_cat: "blen1 (bcat1 xs ys) = add (blen1 xs) (blen1 ys)"
  by (induct xs) simp_all

datatype Ct2 = Cl2 Nat | Cn2 Ct2 Ct2

fun cmir2 :: "Ct2 => Ct2" where
  "cmir2 (Cl2 v) = Cl2 v"
| "cmir2 (Cn2 l r) = Cn2 (cmir2 r) (cmir2 l)"

fun csize2 :: "Ct2 => Nat" where
  "csize2 (Cl2 v) = S Z"
| "csize2 (Cn2 l r) = add (csize2 l) (csize2 r)"

lemma cmir2_mir: "cmir2 (cmir2 t) = t"
  by (induct t) simp_all

lemma csize2_mir: "csize2 (cmir2 t) = csize2 t"
  by (induct t) (simp_all add: add_comm)

