type Nat is Data:
  Z{}
  S{pred: Nat}

law add:
  for a: Nat
  for b: Nat
  Nat

def add(a, b):
  match a:
    case Z{}:
      b
    case S{a}:
      S{add(a, b)}

type Bx<-A: Type> is Type:
  Bx{val: A}

type Pr<-A: Type, -B: Type> is Type:
  MkP{fst: A, snd: B}

type Opt<-A: Type> is Type:
  No{}
  Yes{val: A}

type Lst<-A: Type> is Type:
  Nl{}
  Cs{head: A, tail: Lst<A>}

law ubx:
  for -A: Type
  for b: Bx<A>
  A

def ubx(A, b):
  match b:
    case Bx{x}:
      x

law swp:
  for -A: Type
  for -B: Type
  for p: Pr<A, B>
  Pr<B, A>

def swp(A, B, p):
  match p:
    case MkP{a, b}:
      MkP{b, a}

law pmap:
  for -A: Type
  for -B: Type
  for -C: Type
  for f: A -> B
  for p: Pr<A, C>
  Pr<B, C>

def pmap(A, B, C, f, p):
  match p:
    case MkP{a, c}:
      MkP{f(a), c}

law getor:
  for -A: Type
  for d: A
  for v: Opt<A>
  A

def getor(A, d, v):
  match v:
    case No{}:
      d
    case Yes{x}:
      x

law omap:
  for -A: Type
  for -B: Type
  for f: A -> B
  for v: Opt<A>
  Opt<B>

def omap(A, B, f, v):
  match v:
    case No{}:
      No{}
    case Yes{x}:
      Yes{f(x)}

law llen:
  for -A: Type
  for xs: Lst<A>
  Nat

def llen(A, xs):
  match xs:
    case Nl{}:
      Z{}
    case Cs{h, t}:
      S{llen(A, t)}

type K0 is Data:
  Ka0{val: Nat}
  Kb0{}

law bx0:
  for x: K0
  Bx<Bx<K0>>

def bx0(x):
  Bx{Bx{x}}

law ub0:
  for b: Bx<Bx<K0>>
  K0

def ub0(b):
  ubx(K0, ubx(Bx<K0>, b))

law sw0:
  for p: Pr<K0, Nat>
  Pr<Nat, K0>

def sw0(p):
  swp(K0, Nat, p)

law pm0:
  for p: Pr<Nat, K0>
  Pr<K0, K0>

def pm0(p):
  pmap(Nat, K0, K0, x => Ka0{x}, p)

law go0:
  for v: Opt<K0>
  K0

def go0(v):
  getor(K0, Kb0{}, v)

law om0:
  for v: Opt<Nat>
  Opt<K0>

def om0(v):
  omap(Nat, K0, x => Ka0{x}, v)

law ln0:
  for xs: Lst<Pr<K0, Nat>>
  Nat

def ln0(xs):
  llen(Pr<K0, Nat>, xs)

law cs0:
  for x: K0
  for y: K0
  Lst<K0>

def cs0(x, y):
  Cs{x, Cs{y, Nl{}}}

