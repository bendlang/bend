theory main
  imports Main
begin

datatype Nat = Z | S Nat

fun add :: "Nat => Nat => Nat" where
  "add Z b = b"
| "add (S a) b = S (add a b)"

datatype 'a Bx = MkBx 'a

datatype ('a, 'b) Pr = MkP 'a 'b

datatype 'a Opt = No | Yes 'a

datatype 'a Lst = Nl | Cs 'a "'a Lst"

fun ubx :: "'a Bx => 'a" where
  "ubx (MkBx x) = x"

fun swp :: "('a, 'b) Pr => ('b, 'a) Pr" where
  "swp (MkP a b) = MkP b a"

fun pmap :: "('a => 'b) => ('a, 'c) Pr => ('b, 'c) Pr" where
  "pmap f (MkP a c) = MkP (f a) c"

fun getor :: "'a => 'a Opt => 'a" where
  "getor d No = d"
| "getor d (Yes x) = x"

fun omap :: "('a => 'b) => 'a Opt => 'b Opt" where
  "omap f No = No"
| "omap f (Yes x) = Yes (f x)"

fun llen :: "'a Lst => Nat" where
  "llen Nl = Z"
| "llen (Cs h t) = S (llen t)"

datatype K0 = Ka0 Nat | Kb0

definition bx0 :: "K0 => ((K0) Bx) Bx" where
  "bx0 x = MkBx (MkBx (x))"

definition ub0 :: "((K0) Bx) Bx => K0" where
  "ub0 b = ubx (ubx (b))"

definition sw0 :: "(K0, Nat) Pr => (Nat, K0) Pr" where
  "sw0 p = swp p"

definition pm0 :: "(Nat, K0) Pr => (K0, K0) Pr" where
  "pm0 p = pmap (%x. Ka0 x) p"

definition go0 :: "K0 Opt => K0" where
  "go0 v = getor Kb0 v"

definition om0 :: "Nat Opt => K0 Opt" where
  "om0 v = omap (%x. Ka0 x) v"

definition ln0 :: "(K0, Nat) Pr Lst => Nat" where
  "ln0 xs = llen xs"

definition cs0 :: "K0 => K0 => K0 Lst" where
  "cs0 x y = Cs x (Cs y Nl)"

