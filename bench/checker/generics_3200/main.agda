module main where

data Eq {A : Set} (x : A) : A -> Set where
  refl : Eq x x
{-# BUILTIN EQUALITY Eq #-}

data Nat : Set where
  Z : Nat
  S : Nat -> Nat

add : Nat -> Nat -> Nat
add Z b = b
add (S a) b = S (add a b)

data Bx (A : Set) : Set where
  bx : A -> Bx A

data Pr (A B : Set) : Set where
  mkP : A -> B -> Pr A B

data Opt (A : Set) : Set where
  no : Opt A
  yes : A -> Opt A

data Lst (A : Set) : Set where
  nl : Lst A
  cs : A -> Lst A -> Lst A

ubx : {A : Set} -> Bx A -> A
ubx (bx x) = x

swp : {A B : Set} -> Pr A B -> Pr B A
swp (mkP a b) = mkP b a

pmap : {A B C : Set} -> (A -> B) -> Pr A C -> Pr B C
pmap f (mkP a c) = mkP (f a) c

getor : {A : Set} -> A -> Opt A -> A
getor d no = d
getor d (yes x) = x

omap : {A B : Set} -> (A -> B) -> Opt A -> Opt B
omap f no = no
omap f (yes x) = yes (f x)

llen : {A : Set} -> Lst A -> Nat
llen nl = Z
llen (cs h t) = S (llen t)

data K0 : Set where
  ka0 : Nat -> K0
  kb0 : K0

bx0 : K0 -> Bx (Bx (K0))
bx0 x = bx (bx (x))

ub0 : Bx (Bx (K0)) -> K0
ub0 b = ubx (ubx (b))

sw0 : Pr K0 Nat -> Pr Nat K0
sw0 p = swp p

pm0 : Pr Nat K0 -> Pr K0 K0
pm0 p = pmap (\ x -> ka0 x) p

go0 : Opt K0 -> K0
go0 v = getor kb0 v

om0 : Opt Nat -> Opt K0
om0 v = omap (\ x -> ka0 x) v

ln0 : Lst (Pr K0 Nat) -> Nat
ln0 xs = llen xs

cs0 : K0 -> K0 -> Lst K0
cs0 x y = cs x (cs y nl)

