namespace Bench

inductive Nat : Type where
  | Z : Nat
  | S : Nat → Nat

def add : Nat → Nat → Nat
  | .Z, b => b
  | .S a, b => .S (add a b)

inductive Bx (A : Type) : Type where
  | Bx : A → Bx A

inductive Pr (A B : Type) : Type where
  | MkP : A → B → Pr A B

inductive Opt (A : Type) : Type where
  | No : Opt A
  | Yes : A → Opt A

inductive Lst (A : Type) : Type where
  | Nl : Lst A
  | Cs : A → Lst A → Lst A

def ubx {A : Type} : Bx A → A
  | .Bx x => x

def swp {A B : Type} : Pr A B → Pr B A
  | .MkP a b => .MkP b a

def pmap {A B C : Type} (f : A → B) : Pr A C → Pr B C
  | .MkP a c => .MkP (f a) c

def getor {A : Type} (d : A) : Opt A → A
  | .No => d
  | .Yes x => x

def omap {A B : Type} (f : A → B) : Opt A → Opt B
  | .No => .No
  | .Yes x => .Yes (f x)

def llen {A : Type} : Lst A → Nat
  | .Nl => .Z
  | .Cs _ t => .S (llen t)

inductive K0 : Type where
  | Ka : Nat → K0
  | Kb : K0

def bx0 (x : K0) : Bx (Bx (K0)) := .Bx (.Bx (x))

def ub0 (b : Bx (Bx (K0))) : K0 := ubx (ubx (b))

def sw0 (p : Pr K0 Nat) : Pr Nat K0 := swp p

def pm0 (p : Pr Nat K0) : Pr K0 K0 := pmap (fun x => K0.Ka x) p

def go0 (v : Opt K0) : K0 := getor K0.Kb v

def om0 (v : Opt Nat) : Opt K0 := omap (fun x => K0.Ka x) v

def ln0 (xs : Lst (Pr K0 Nat)) : Nat := llen xs

def cs0 (x y : K0) : Lst K0 := .Cs x (.Cs y .Nl)

