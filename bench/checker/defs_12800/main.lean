namespace Bench

inductive Nat : Type where
  | Z : Nat
  | S : Nat → Nat

def add : Nat → Nat → Nat
  | .Z, b => b
  | .S a, b => .S (add a b)

def mul : Nat → Nat → Nat
  | .Z, _ => .Z
  | .S a, b => add b (mul a b)

def dbl (x : Nat) : Nat := add x x

inductive L : Type where
  | Ln : L
  | Lc : Nat → L → L

def cat : L → L → L
  | .Ln, ys => ys
  | .Lc h t, ys => .Lc h (cat t ys)

def fa0 : Nat → Nat
  | .Z => dbl (.S .Z)
  | .S q => .S (fa0 q)

def ga0 (x y : Nat) : Nat := add (fa0 x) (dbl y)

def fb1 : L → L
  | .Ln => .Ln
  | .Lc h t => .Lc (fa0 h) (fb1 t)

def fc2 : L → Nat
  | .Ln => .Z
  | .Lc h t => add (fa0 h) (fc2 t)

def gc2 (x : Nat) : Nat := fc2 (.Lc x (.Lc (fa0 x) .Ln))

