module main where

data Eq {A : Set} (x : A) : A -> Set where
  refl : Eq x x
{-# BUILTIN EQUALITY Eq #-}

data Nat : Set where
  Z : Nat
  S : Nat -> Nat

add : Nat -> Nat -> Nat
add Z b = b
add (S a) b = S (add a b)

mul : Nat -> Nat -> Nat
mul Z b = Z
mul (S a) b = add b (mul a b)

dbl : Nat -> Nat
dbl x = add x x

data L : Set where
  Ln : L
  Lc : Nat -> L -> L

cat : L -> L -> L
cat Ln ys = ys
cat (Lc h t) ys = Lc h (cat t ys)

