theory main
  imports Main
begin

datatype Nat = Z | S Nat

fun add :: "Nat => Nat => Nat" where
  "add Z b = b"
| "add (S a) b = S (add a b)"

fun mul :: "Nat => Nat => Nat" where
  "mul Z b = Z"
| "mul (S a) b = add b (mul a b)"

definition dbl :: "Nat => Nat" where
  "dbl x = add x x"

datatype L = Ln | Lc Nat L

fun cat :: "L => L => L" where
  "cat Ln ys = ys"
| "cat (Lc h t) ys = Lc h (cat t ys)"

fun fa0 :: "Nat => Nat" where
  "fa0 Z = dbl (S Z)"
| "fa0 (S q) = S (fa0 q)"

definition ga0 :: "Nat => Nat => Nat" where
  "ga0 x y = add (fa0 x) (dbl y)"

fun fb1 :: "L => L" where
  "fb1 Ln = Ln"
| "fb1 (Lc h t) = Lc (fa0 h) (fb1 t)"

fun fc2 :: "L => Nat" where
  "fc2 Ln = Z"
| "fc2 (Lc h t) = add (fa0 h) (fc2 t)"

definition gc2 :: "Nat => Nat" where
  "gc2 x = fc2 (Lc x (Lc (fa0 x) Ln))"

