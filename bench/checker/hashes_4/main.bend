import Base

def mix(+a: U32, +b: U32) -> U32:
  U32.add(U32.xor(a, U32.shln(b, 5n)), U32.xor(U32.shrn(a, 3n), b))

def fold(xs: List<&2, U32>, a: U32) -> U32:
  match xs:
    case []: a
    case x <> rest: fold(rest, mix(a, x))

def rounds(n: Nat, a: U32, +xs: List<&2, U32>) -> U32:
  match n:
    case 0n: a
    case 1n+p: rounds(p, fold(xs, a), xs)

def root(+xs: List<&2, U32>) -> U32:
  rounds(64n, 0, xs)

def under(h: U32, limit: Nat) -> Bool:
  Nat.is_le(U32.to_nat(U32.and(h, 1023)), limit)

law root_0:
  {under(root([3280387012, 1095513148, 1930549411, 2798570523, 3387541014, 403123852, 3589583794, 1912923437, 4059906722, 3871601465, 131383004, 2325348894, 1001090105, 92297589, 2758633299, 3693442237]), U32.to_nat(2097152)) == under(root([3280387012, 1095513148, 1930549411, 2798570523, 3387541014, 403123852, 3589583794, 1912923437, 4059906722, 3871601465, 131383004, 2325348894, 1001090105, 92297589, 2758633299, 3693442237]), U32.to_nat(2097152)) : Bool}
def root_0(): {==}

